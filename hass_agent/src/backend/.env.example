# Home Assistant connection
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=your_long_lived_access_token_here

# LLM provider (choose one or both)
# OpenAI-compatible (llama.cpp, Ollama, etc.)
OPENAI_BASE_URL=http://192.168.1.x:8081
OPENAI_API_KEY=                        # leave blank if not required

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OAuth redirect URI (change for LAN/mobile testing)
OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback

# Session secret (set a fixed value to survive backend restarts)
SESSION_SECRET=change-me-to-a-random-string
